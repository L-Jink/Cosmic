<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Simulated players (ADR 0001). is_sim = 1 marks a resident bot so it can be wiped in one query. -->
    <changeSet id="sim-1-characters-is-sim" author="cosmic-sim">
        <addColumn tableName="characters">
            <column name="is_sim" type="TINYINT(1)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex tableName="characters" indexName="idx_characters_is_sim">
            <column name="is_sim"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
